{
 "manifest_version": 3,
 "name": "Vantage 安全防护",
 "default_locale": "zh_CN",
 "version": "2.5.2",
 "version_name": "2.5.2",
 "description": "Vantage 内置钓鱼网站检测：域名仿冒分析、ICP备案检查、下载检测、链接分析和代码工程化检测，保护您的数字安全",
 "permissions": [
  "activeTab",
  "storage",
  "downloads",
  "scripting",
  "alarms",
  "notifications",
  "webNavigation"
 ],
 "host_permissions": [
  "http://*/*",
  "https://*/*"
 ],
 "background": {
  "scripts": [
   "background/service-worker.js"
  ],
  "type": "module"
 },
 "content_scripts": [
  {
   "matches": [
    "http://*/*",
    "https://*/*"
   ],
   "js": [
    "content/navigation-guard.js"
   ],
   "run_at": "document_start",
   "all_frames": false,
   "world": "MAIN"
  },
  {
   "matches": [
    "http://*/*",
    "https://*/*"
   ],
   "js": [
    "content/content-script.js"
   ],
   "run_at": "document_idle",
   "all_frames": false
  }
 ],
 "web_accessible_resources": [
  {
   "resources": [
    "warning/warning.html",
    "warning/warning.js",
    "warning/warning.css",
    "warning/download-confirm.html",
    "warning/download-confirm.js",
    "warning/download-confirm.css"
   ],
   "matches": [
    "http://*/*",
    "https://*/*"
   ]
  }
 ],
 "options_ui": {
  "page": "options/options.html",
  "open_in_tab": true
 },
 "action": {
  "default_popup": "popup/popup.html",
  "default_icon": {
   "16": "icons/icon16.png",
   "32": "icons/icon32.png",
   "48": "icons/icon48.png",
   "128": "icons/icon128.png"
  }
 },
 "icons": {
  "16": "icons/icon16.png",
  "32": "icons/icon32.png",
  "48": "icons/icon48.png",
  "128": "icons/icon128.png"
 },
 "browser_specific_settings": {
  "gecko": {
   "id": "virusdetector@asystech.cn",
   "strict_min_version": "140.0",
   "data_collection_permissions": {
    "required": [
     "none"
    ]
   }
  }
 }
}
